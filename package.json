{
  "name": "local-auto-apply-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "node backend/server.js",
    "dev:frontend": "cd frontend && npx vite --port 3000",
    "test": "node --test tests/**/*.test.js",
    "test:playwright": "npx playwright test tests/playwright/",
    "fake-site": "node tests/fake-job-site/server.js",
    "build:frontend": "cd frontend && npx vite build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.48.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  }
}
